PORT=5003
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=thinknalyze
DB_SSLMODE=disable
redis=true
REDIS_HOST=redis
REDIS_PORT=6379
# compatibility: some services expect lowercase env names
redis_host=redis
redis_port=6379
redis_pass=
redis_db=0
# Email provider configuration (set these to enable sending)
# Brevo (recommended): set your API key
BREVO_API_KEY=
# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@your-domain.com"
